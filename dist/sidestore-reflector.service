[Unit]
Description=SideStore Tailscale Reflector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/sidestore-reflector
StateDirectory=sidestore-reflector
DynamicUser=yes
NoNewPrivileges=yes
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
